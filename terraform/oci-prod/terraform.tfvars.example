# Copy this file to terraform.tfvars and fill in your actual OCIDs.
# NEVER commit terraform.tfvars — it contains your tenancy identifiers.

tenancy_ocid   = "ocid1.tenancy.oc1..xxxxxxxxxxxx"
compartment_ocid = "ocid1.compartment.oc1..xxxxxxxxxxxx"
availability_domain = "xxxx:PHX-AD-1"
subnet_id = "ocid1.subnet.oc1..xxxxxxxxxxxx"
vcn_id = "ocid1.vcn.oc1..xxxxxxxxxxxx"
kms_key_id = "ocid1.key.oc1..xxxxxxxxxxxx"
boot_image_id = "ocid1.image.oc1..xxxxxxxxxxxx"

instance_shape = "VM.Standard.E4.Flex"
ocpus = 4
memory_in_gbs = 8
boot_volume_size_in_gbs = 100
display_name = "aviation-dms-prod"

bastion_ip = "145.241.152.126/32"
backend_vcn_cidr = "10.0.0.0/16"
