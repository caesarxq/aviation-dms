# Local development defaults only. Production settings are documented in
# docs/PRODUCTION-DEPLOYMENT.md and must be supplied from protected secrets.

DMS_RELEASE_TAG=local
DMS_DB_PATH=./data/dms.db
DEV_MODE=true
FLIGHT_RELEASE_ENABLED=false
SESSION_COOKIE_SECURE=false
AUTH_ALLOWED_ORIGINS=http://localhost:5173
CORS_ORIGINS=http://localhost:5173
PUBLIC_APP_URL=http://localhost:5173

# Leave unset for local development. Production Compose requires a mounted secret file.
# KFL_BOOTSTRAP_TOKEN_FILE=/run/secrets/kfl_bootstrap_token

# Email/reset delivery is disabled until a real SMTP service is configured.
NOTIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Production Compose reads this host-side file as a Docker secret, not from an environment value.
# SMTP_PASS_SECRET_FILE=/root/.secrets/kfl-smtp-password
SMTP_FROM=

HOST=127.0.0.1
PORT=8000
