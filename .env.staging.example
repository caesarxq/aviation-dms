# ============================================================================
# Aviation DMS — Staging Environment (Local/Cloud)
# ============================================================================
# Copy this file to .env.staging and fill in your values.
# NEVER commit .env.staging — it contains environment-specific configuration.
# ============================================================================

# Image tag for staging builds
DMS_RELEASE_TAG=staging-local

# Database path
DMS_DB_PATH=/app/data/dms.db

# Staging mode
DEV_MODE=true
FLIGHT_RELEASE_ENABLED=false
SESSION_COOKIE_SECURE=false

# Staging domain and CORS
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://stage.kfl.ke
CORS_ORIGINS=http://localhost:5173,http://stage.kfl.ke
PUBLIC_APP_URL=http://stage.kfl.ke

# Host binding
HOST=0.0.0.0
PORT=8000

# Scanner settings
DMS_CLAMD_HOST=clamd
DMS_CLAMD_PORT=3310
DMS_CLAMD_TIMEOUT_SECONDS=60
DMS_CLAMD_MAX_TIMEOUT_SECONDS=60

# Upload quota (staging: 1 GB for testing)
DMS_UPLOAD_QUOTA_SCOPE=system
DMS_UPLOAD_STORAGE_QUOTA_BYTES=1073741824

# Evidence and import limits
DMS_AUDIT_EVIDENCE_MAX_BYTES=10485760
DMS_P3_IMPORT_BODY_MAX_BYTES=5242880

# Upload validator URL
DMS_UPLOAD_VALIDATOR_URL=http://upload-validator:9100/validate

# Session settings
SESSION_TTL_SECONDS=3600
SESSION_ABSOLUTE_MAX_SECONDS=7200
RATE_LIMIT_REQUESTS_PER_MIN=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=1000

# Notification disabled for staging
NOTIFICATION_ENABLED=false
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# Bootstrap token
KFL_BOOTSTRAP_TOKEN_FILE=/run/secrets/kfl_bootstrap_token

# Trusted frontend IP
DMS_TRUSTED_FRONTEND_IP=172.31.254.3

# ACME email for staging (self-signed/local)
ACME_EMAIL=admin@localhost.local

# Staging hostname
DMS_HOSTNAME=stage.kfl.ke
