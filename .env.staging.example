# ============================================================================
# Aviation DMS — Staging Environment (Local/Cloud)
# ============================================================================
# Copy this file to .env.staging and fill in your values.
# NEVER commit .env.staging — it contains environment-specific configuration.
# ============================================================================

# Image tag for staging builds
DMS_RELEASE_TAG=staging-local

# Database path
DMS_DB_PATH=/app/data/dms.db

# Staging mode. DEV_MODE must stay false on any network-exposed host: the
# X-Actor/X-Role development identity path is a local-only convenience and is
# additionally refused for proxied requests by the auth middleware.
DEV_MODE=false
FLIGHT_RELEASE_ENABLED=false
# Staging is served over HTTPS (Caddy TLS), so session/CSRF cookies must be Secure
# (this also enables the __Host- cookie prefix).
SESSION_COOKIE_SECURE=true

# Staging domain and CORS
AUTH_ALLOWED_ORIGINS=http://localhost:5173,http://stage.kfl.ke
CORS_ORIGINS=http://localhost:5173,http://stage.kfl.ke
PUBLIC_APP_URL=http://stage.kfl.ke

# Local default; deploy-staging.sh explicitly overrides cloud bindings to 10.20.4.234.
HOST=0.0.0.0
PORT=8000
DMS_BACKEND_BIND_IP=127.0.0.1
DMS_BACKEND_HOST_PORT=8001
DMS_FRONTEND_BIND_IP=127.0.0.1
DMS_FRONTEND_HOST_PORT=8081

# Scanner settings
DMS_CLAMD_HOST=clamd
DMS_CLAMD_PORT=3310
DMS_CLAMD_TIMEOUT_SECONDS=60
DMS_CLAMD_MAX_TIMEOUT_SECONDS=60

# Upload quota (staging: 1 GB for testing)
DMS_UPLOAD_QUOTA_SCOPE=system
DMS_UPLOAD_STORAGE_QUOTA_BYTES=1073741824

# Evidence and import limits
DMS_AUDIT_EVIDENCE_MAX_BYTES=10485760
DMS_P3_IMPORT_BODY_MAX_BYTES=5242880

# Upload validator URL
DMS_UPLOAD_VALIDATOR_URL=http://upload-validator:9100/validate

# Session settings
SESSION_TTL_SECONDS=3600
SESSION_ABSOLUTE_MAX_SECONDS=7200
RATE_LIMIT_REQUESTS_PER_MIN=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=1000

# Notification enabled for staging via Zoho sandbox SMTP
NOTIFICATION_ENABLED=true
INVITE_EMAIL_ENABLED=true
SMTP_HOST=smtppro.zoho.com
SMTP_PORT=587
SMTP_USER=staging@kfl.ke
# SMTP app-specific password must NOT be stored here; it is injected at runtime
# via the smtp_pass Docker secret (/run/secrets/smtp_pass) on the staging host.
SMTP_PASS=
SMTP_FROM=staging@kfl.ke

# Zoho BugTracker is retained. Put OAuth values in protected host-side files;
# never place tokens or client secrets in this environment file.
ZOHO_BUGTRACKER_PORTAL=kfldotke
ZOHO_BUGTRACKER_PROJECT_ID=2730932000000114802
ZOHO_CLIENT_ID_SECRET_FILE=/opt/kfl-aviation-dms-staging/secrets/zoho_client_id
ZOHO_CLIENT_SECRET_SECRET_FILE=/opt/kfl-aviation-dms-staging/secrets/zoho_client_secret
ZOHO_REFRESH_TOKEN_SECRET_FILE=/opt/kfl-aviation-dms-staging/secrets/zoho_refresh_token

# Bootstrap token
KFL_BOOTSTRAP_TOKEN_FILE=/run/secrets/kfl_bootstrap_token

# Trusted frontend IP
DMS_TRUSTED_FRONTEND_IP=172.31.254.3

# ACME email for staging (self-signed/local)
ACME_EMAIL=admin@localhost.local

# Staging hostname
DMS_HOSTNAME=stage.kfl.ke
