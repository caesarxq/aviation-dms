# ============================================================================
# Aviation DMS — Production Environment (OCI)
# ============================================================================
# Production runs on OCI compute instance with proper domain and HTTPS.
# Copy this file to .env.prod and fill in your actual values.
# NEVER commit .env.prod — it contains production secrets.
# ============================================================================

# Image tag for production builds (set by CI/CD)
DMS_RELEASE_TAG=prod-20261111

# Database path on OCI instance
DMS_DB_PATH=/app/data/dms.db

# Production mode — strict security
DEV_MODE=false
FLIGHT_RELEASE_ENABLED=false
SESSION_COOKIE_SECURE=true

# Production domain and CORS
AUTH_ALLOWED_ORIGINS=https://roc.kfl.ke
CORS_ORIGINS=https://roc.kfl.ke
PUBLIC_APP_URL=https://roc.kfl.ke

# Host binding (bind to all interfaces on OCI)
HOST=0.0.0.0
PORT=8000

# Scanner settings (production uses local clamd on same VCN)
DMS_CLAMD_HOST=clamd
DMS_CLAMD_PORT=3310
DMS_CLAMD_TIMEOUT_SECONDS=60
DMS_CLAMD_MAX_TIMEOUT_SECONDS=60

# Upload quota (production: 30 GB, Records Custodian approved)
DMS_UPLOAD_QUOTA_SCOPE=system
DMS_UPLOAD_STORAGE_QUOTA_BYTES=30000000000

# Evidence and import limits
DMS_AUDIT_EVIDENCE_MAX_BYTES=10485760
DMS_P3_IMPORT_BODY_MAX_BYTES=5242880

# Upload validator URL (production internal network)
DMS_UPLOAD_VALIDATOR_URL=http://upload-validator:9100/validate

# Session settings (production TTL)
SESSION_TTL_SECONDS=28800
SESSION_ABSOLUTE_MAX_SECONDS=86400
RATE_LIMIT_REQUESTS_PER_MIN=100
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_CLIENTS=10000

# Notification enabled for production
NOTIFICATION_ENABLED=false
SMTP_HOST=smtp.staging.kfl.ke
SMTP_PORT=587
SMTP_USER=staging@kfl.ke
SMTP_PASS=staging-pass
SMTP_FROM=staging@kfl.ke

# Bootstrap token (production — mounted as Docker secret)
KFL_BOOTSTRAP_TOKEN_FILE=/run/secrets/kfl_bootstrap_token

# Trusted frontend IP (OCI internal network)
DMS_TRUSTED_FRONTEND_IP=145.241.152.126/32

# ACME email for Let's Encrypt certificates
ACME_EMAIL=admin@kfl.ke

# Public hostname for Caddy
DMS_HOSTNAME=roc.kfl.ke
