{
  "$schema": "https://raw.githubusercontent.com/stryker-mutator/stryker-js/master/packages/api/core/src/config-schema.json",
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.ts",
    "related": true
  },
  "checkers": ["typescript"],
  "tsconfigFile": "tsconfig.json",
  "mutate": [
    "src/components/documents/DocumentOutline.tsx:11-68",
    "src/utils/validation.ts"
  ],
  "testFiles": [
    "src/components/documents/DocumentOutline.test.tsx",
    "src/utils/validation.test.ts"
  ],
  "concurrency": 2,
  "timeoutMS": 5000,
  "reporters": ["clear-text", "html", "json"],
  "coverageAnalysis": "perTest",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 0
  }
}
