# Non-secret configuration only. Copy to /etc/kfl-aviation-dms-prod/backup.env.
# Keep the systemd timer disabled until destination, credentials, retention, and
# restore acceptance are approved and verified.
DMS_BACKUP_VOLUME_NAME=kfl-aviation-dms-prod_dms_data
DMS_BACKUP_BACKEND_CONTAINER=kfl-aviation-dms-prod-backend-1
DMS_BACKUP_APP_SOURCE=/opt/kfl-aviation-dms-prod/backup-tool/app
DMS_BACKUP_STAGING_ROOT=/var/lib/kfl-aviation-dms-prod-backups/staging
# This path must be a dedicated mounted OCI block volume. The owner/ops attestation
# is created only after independently verifying its encryption and mount mapping.
DMS_BACKUP_STAGING_ATTESTATION_FILE=/etc/kfl-aviation-dms-prod/backup-secrets/staging-encryption.json

# Restic's SFTP repository is encrypted using the separate password file below.
# Set the repository host to the same host as DMS_BACKUP_SSH_HOST after verifying
# its SSH host-key fingerprint out of band.
DMS_BACKUP_RESTIC_REPOSITORY=
DMS_BACKUP_RESTIC_PASSWORD_FILE=/etc/kfl-aviation-dms-prod/backup-secrets/restic_password
DMS_BACKUP_SSH_HOST=
DMS_BACKUP_SSH_IDENTITY_FILE=/etc/kfl-aviation-dms-prod/backup-secrets/backup_ssh_key
DMS_BACKUP_SSH_KNOWN_HOSTS_FILE=/etc/kfl-aviation-dms-prod/backup-secrets/backup_known_hosts
