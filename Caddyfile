{
	email {$ACME_EMAIL}
}

:443 {

	host roc.kfl.ke {
		encode gzip zstd

		header {
			Strict-Transport-Security "max-age=31536000"
			X-Content-Type-Options "nosniff"
			X-Frame-Options "DENY"
			Referrer-Policy "no-referrer"
			Permissions-Policy "camera=(), microphone=(), geolocation=()"
			Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline' data:; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; frame-src 'self' about:; object-src 'none'; base-uri 'self'; frame-ancestors 'none'"
		}

		# API routes -> backend (port 8000) with 10 MiB body limit
		reverse_proxy /api/* backend:8000 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
			transport {
				response_header_timeout 30s
				dial_timeout 10s
				tls_timeout 10s
			}
		}

		# All other routes -> frontend (port 80) with 1 MiB body limit
		reverse_proxy frontend:80 {
			header_up Host {upstream_hostport}
			header_up X-Real-IP {remote}
			header_up X-Forwarded-For {remote}
			header_up X-Forwarded-Proto {scheme}
		}
	}

	host www.roc.kfl.ke {
		redir https://roc.kfl.ke{uri} permanent
	}
}
